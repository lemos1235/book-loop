{
  "name": "book-loop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "user:password": "node --env-file-if-exists=.env scripts/reset-password.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.3.0",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "bits-ui": "^2.21.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.2.3",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@lucide/svelte": "^1.72.0",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^13.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
